{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-deep-dive/schemas/eval.schema.json",
  "title": "TradePlanEval",
  "description": "Machine-resolvable evaluation of a taken trade plan, written to trade-plans/<TICKER>/<DATE>/eval-<review_date>.json. Marks the plan to market path-aware, grades the reasoning behind it, scores calibration, and records the ledger lessons it proposed. Consumed for aggregate calibration over time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticker", "plan_date", "review_date", "generated", "plan_path",
    "trade_taken", "outcome", "reasoning_review", "calibration",
    "attribution", "lessons", "disclaimer"
  ],
  "properties": {
    "ticker": { "type": "string", "pattern": "^[A-Z][A-Z0-9.]{0,5}$" },
    "plan_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "review_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generated": { "type": "string" },
    "plan_path": { "type": "string" },
    "trade_taken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicle", "direction", "entry"],
      "description": "What was actually executed (may differ from the plan).",
      "properties": {
        "vehicle": { "enum": ["stock", "option", "none"] },
        "direction": { "enum": ["long", "short"] },
        "entry": { "type": ["number", "string"] },
        "entry_date": { "type": ["string", "null"] },
        "stop": { "type": ["number", "null"] },
        "targets": { "type": "array", "items": { "type": "number" } },
        "structure": { "type": ["string", "null"] },
        "size_pct_book": { "type": ["number", "null"] },
        "matched_plan": { "type": ["boolean", "null"], "description": "did execution follow the plan?" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "r_achieved"],
      "properties": {
        "status": { "enum": ["WIN", "LOSS", "OPEN", "INCONCLUSIVE"] },
        "r_achieved": { "type": ["number", "null"] },
        "mfe_R": { "type": ["number", "null"] },
        "mae_R": { "type": ["number", "null"] },
        "first_target_date": { "type": ["string", "null"] },
        "stop_hit_date": { "type": ["string", "null"] },
        "invalidation_price_hit": { "type": ["boolean", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "reasoning_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction_call", "components"],
      "properties": {
        "direction_call": { "enum": ["RIGHT", "WRONG", "UNRESOLVED"] },
        "flow_chart_agreement_call": { "enum": ["RIGHT", "WRONG", "UNRESOLVED", "NA"] },
        "pattern_call": { "enum": ["PLAYED_OUT", "FAILED", "UNCONFIRMED", "NA"] },
        "level_quality": { "enum": ["GOOD", "STOP_TOO_TIGHT", "TARGET_TOO_FAR", "TARGET_TOO_NEAR", "MIXED", "NA"] },
        "sizing_review": { "enum": ["APPROPRIATE", "OVERSIZED", "UNDERSIZED", "NA"] },
        "components": {
          "type": "array",
          "description": "Per reason_for / reason_against verdict.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "side", "verdict"],
            "properties": {
              "claim": { "type": "string" },
              "side": { "enum": ["for", "against"] },
              "verdict": { "enum": ["RIGHT", "WRONG", "UNRESOLVED"] },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conviction", "brier"],
      "properties": {
        "conviction": { "enum": [0.55, 0.65, 0.75, 0.85, 0.95] },
        "outcome_bit": { "type": ["integer", "null"], "enum": [0, 1, null] },
        "brier": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "verdict": { "enum": ["WELL_CALIBRATED", "OVERCONFIDENT", "UNDERCONFIDENT", "NA"] }
      }
    },
    "attribution": {
      "type": "array",
      "description": "Which evidence lanes were decisive (for or against).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "effect"],
        "properties": {
          "lane": { "type": "string", "description": "flow|dark_pool|positioning|dealer_structure|historical|chart_trend|chart_pattern|macro|fundamentals|sentiment" },
          "effect": { "enum": ["decisive_right", "decisive_wrong", "minor", "neutral"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "lessons": {
      "type": "array",
      "description": "Ledger lessons appended/promoted/retired by this eval (propose-only for rubric edits).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "scope", "lesson"],
        "properties": {
          "id": { "type": "string", "pattern": "^L-[0-9]{4}$" },
          "status": { "enum": ["CANDIDATE", "ACTIVE", "RETIRED"] },
          "scope": { "type": "array", "items": { "type": "string" } },
          "lesson": { "type": "string" },
          "applies_to": { "type": ["string", "null"] }
        }
      }
    },
    "proposed_rubric_edits": {
      "type": "array",
      "description": "Propose-only edits to generator rubrics (never auto-applied).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "change"],
        "properties": {
          "file": { "type": "string" },
          "change": { "type": "string" },
          "rationale": { "type": ["string", "null"] }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eval_md": { "type": ["string", "null"] },
        "ledger": { "type": ["string", "null"] }
      }
    },
    "disclaimer": { "type": "string" }
  }
}
